    "bindings": [
      {
        "id": "last_stand_trigger",
        "name": "Last Stand",
        "trigger": "OnHPThresholdCrossed",
        "conditions": [
          {
            "type": "self"
          },
          {
            "type": "statCompare",
            "target": "self",
            "stat": "hpPercent",
            "op": "<=",
